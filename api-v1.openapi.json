{
  "openapi": "3.0.3",
  "info": {
    "title": "İtme Arenası P22 API",
    "version": "1.0.0",
    "description": "Anonymous account creation and bearer profile; economy/results remain closed."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development only"
    }
  ],
  "paths": {
    "/api/v1/catalog": {
      "get": {
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "400": {
            "description": "Invalid method/query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
