  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "protocolVersion",
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "protocolVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN",
              "OUT_OF_SERVICE",
              "UNKNOWN"
            ]
          }
        }
      },
      "Character": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "statsProfileId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "statsProfileId": {
            "type": "string"
          }
        }
      },
      "Map": {
        "type": "object",
        "required": [
          "id",
          "displayName"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "Accessory": {
        "type": "object",
        "required": [
          "id",
          "characterId",
          "displayName",
          "purchasable"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "characterId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "purchasable": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "Catalog": {
        "type": "object",
        "required": [
          "schemaVersion",
          "characters",
          "maps",
          "accessories"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "characters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Character"
            }
          },
          "maps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Map"
            }
          },
          "accessories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Accessory"
            }
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "schemaVersion",
          "playerId",
          "nickname",
          "characterId",
          "equippedAccessoryIds"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "playerId": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string",
            "description": "Free display name; no uniqueness or content/length rule. Blank input becomes Oyuncu. Control characters are silently removed."
          },
          "characterId": {
            "type": "string"
          },
          "equippedAccessoryIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Register": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registrationKey",
          "nickname",
          "characterId"
        ],
        "properties": {
          "registrationKey": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "writeOnly": true
          },
          "nickname": {
            "type": "string",
            "description": "Free display name; no uniqueness or content/length rule. Blank input becomes Oyuncu. Control characters are silently removed."
          },
          "characterId": {
            "type": "string",
            "maxLength": 40
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "protocolVersion",
          "profile",
          "accessToken",
          "expiresAt"
        ],
        "properties": {
          "protocolVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Wallet": {
        "type": "object",
        "required": [
          "protocolVersion",
          "balance",
          "revision"
        ],
        "properties": {
          "protocolVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "balance": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "RewardReceipt": {
        "type": "object",
        "required": [
          "protocolVersion",
          "balance",
          "revision",
          "matchId",
          "status",
          "amount"
        ],
        "properties": {
          "protocolVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "balance": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "matchId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "granted",
              "ineligible",
              "pending_or_unverified"
            ]
          },
          "amount": {
            "type": "integer",
            "enum": [
              0,
              200
            ]
          }
        },
        "description": "Balance fields meaningful only for granted/ineligible; pending does not claim zero balance."
      },
      "ShopProduct": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "accessory",
              "ability"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "characterId": {
            "type": [
              "string",
              "null"
            ]
          },
          "slot": {
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "purchasable": {
            "type": "boolean"
          },
          "abilityId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "displayName",
          "characterId",
          "slot",
          "price",
          "version",
          "purchasable",
          "abilityId"
        ]
      },
      "ShopCatalog": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "protocolVersion": {
            "const": 1
          },
          "priceStatus": {
            "const": "reference-example-not-final"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShopProduct"
            }
          }
        },
        "required": [
          "protocolVersion",
          "priceStatus",
          "products"
        ]
      },
      "ShopState": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "protocolVersion": {
            "const": 1
          },
          "balance": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "profileRevision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "characterId": {
            "type": "string"
          },
          "ownedAccessoryIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "equippedAccessoryIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "equippedAbilityId": {
            "const": "common_stun"
          }
        },
        "required": [
          "protocolVersion",
          "balance",
          "revision",
          "profileRevision",
          "characterId",
          "ownedAccessoryIds",
          "equippedAccessoryIds",
          "equippedAbilityId"
        ]
      },
      "ShopPurchase": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string"
          },
          "expectedPrice": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "requestId",
          "productId",
          "expectedPrice",
          "expectedVersion"
        ]
      },
      "ShopBought": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "protocolVersion": {
            "const": 1
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "purchased",
              "already_owned"
            ]
          },
          "paid": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "balance": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "protocolVersion",
          "requestId",
          "productId",
          "status",
          "paid",
          "balance",
          "revision"
        ]
      },
      "ShopEquip": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "characterId": {
            "type": "string"
          },
          "accessoryIds": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "abilityId": {
            "const": "common_stun"
          },
          "expectedRevision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "characterId",
          "accessoryIds",
          "abilityId",
          "expectedRevision"
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
